{
  "name": "@saferoot/backend",
  "version": "0.1.0",
  "private": true,
  "description": "SafeRoot Policy backend: REST API, Safe watcher, Attestcoin proof worker, Creditcoin CC3 chain indexer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@gluwa/usc-sdk": "^0.18.0",
    "@prisma/client": "^6.1.0",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
