NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*

DATABASE_URL=postgresql://saferoot:saferoot@localhost:5432/saferoot?schema=public

ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CREDITCOIN_CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

SAFE_TX_SERVICE_BASE_URL=https://safe-transaction-sepolia.safe.global/api/v1
SAFE_TX_SERVICE_API_KEY=

WORKER_WALLET_PRIVATE_KEY=0xREPLACE_WITH_A_FUNDED_CC3_TESTNET_WALLET_PRIVATE_KEY

ATTESTCOIN_MODE=usc
ATTESTCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
ATTESTCOIN_PROOF_TIMEOUT_MS=10000
ATTESTCOIN_INTERIM_ATTESTOR_PRIVATE_KEY=

SAFE_WATCHER_POLL_INTERVAL_MS=6000
ATTESTCOIN_WORKER_POLL_INTERVAL_MS=10000
CHAIN_INDEXER_POLL_INTERVAL_MS=8000

# Optional overrides; by default these resolve to ../contracts/deployments.json and ../contracts/abi
# relative to this package, matching the npm workspace layout.
# DEPLOYMENTS_JSON_PATH=/absolute/path/to/contracts/deployments.json
# ABI_DIR_PATH=/absolute/path/to/contracts/abi
